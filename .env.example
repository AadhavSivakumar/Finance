# Copy to .env and edit. `.env` is gitignored -- it must never be committed,
# and .dockerignore keeps it out of the build context so it cannot be baked
# into an image layer either.
#
# Compose reads .env from the project root automatically and uses it for
# ${VAR} substitution in the compose files.

# --- database -------------------------------------------------------------
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_DB=finance

# --- app ------------------------------------------------------------------
LOG_LEVEL=INFO

# Host ports (dev only). Change these if another project already owns one --
# only the host side of a port mapping can conflict.
WEB_PORT=5173
API_PORT=8000

# Which host interface the dashboard is published on.
#   127.0.0.1        this machine only (default, safest)
#   <tailscale-ip>   reachable from your tailnet only -- encrypted + authenticated
#   0.0.0.0          every interface, including your local network
# There is NO authentication in this app. Do not use 0.0.0.0 on a network you
# do not fully trust.
BIND_ADDR=127.0.0.1

# Market data source:
#   openbb  = real data via the OpenBB Platform (default here)
#   demo    = deterministic synthetic prices, offline, no account needed
#   finnhub = Finnhub directly; free key at https://finnhub.io
MARKET_PROVIDER=openbb

# Which upstream source OpenBB pulls from. yfinance needs no API key. Others
# (fmp, intrinio, polygon, tiingo) need credentials in OpenBB's own store.
MARKET_OPENBB_PROVIDER=yfinance

# Only used when MARKET_PROVIDER=finnhub.
MARKET_API_KEY=

# Load the demo dataset on first start (dev only; forced to 0 in prod).
SEED_DEMO_DATA=1

# Set to 1 if file-watching/HMR does not pick up your edits.
VITE_USE_POLLING=0

# Your host uid/gid, so files the api container writes into the bind-mounted
# ./backend (e.g. generated migrations) are owned by you. Check with `id -u`
# and `id -g`; 1000:1000 is the default for the first user on most systems.
DOCKER_UID=1000
DOCKER_GID=1000

# --- production only ------------------------------------------------------
# Domain Caddy requests a TLS certificate for. Must already point at this host.
DOMAIN=finance.example.com
PUBLIC_ORIGIN=https://finance.example.com

# Image registry and tag used by `docker compose build/push/pull`.
REGISTRY=ghcr.io/yourname
TAG=latest

# Uvicorn worker processes. Rule of thumb: (2 x CPU cores) + 1, capped by RAM.
WEB_CONCURRENCY=2
